generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Deployment {
  id         String           @id
  project_id String
  status     DeploymentStatus @default(NOT_STARTED)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime
  Project    Project          @relation(fields: [project_id], references: [id])
}

model Log {
  id           String   @id
  projectId    String
  deploymentId String
  log          String
  createdAt    DateTime @default(now())
  Project      Project  @relation(fields: [projectId], references: [id])
}

model Project {
  id            String       @id
  name          String
  git_url       String
  subdomain     String
  custom_domain String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime
  Deployment    Deployment[]
  Log           Log[]
  User          User[]
}

model User {
  id       String    @id
  name     String
  email    String    @unique
  password String
  Project  Project[]
}

enum DeploymentStatus {
  NOT_STARTED
  QUEUED
  IN_PROGRESS
  READY
  FAIL
}
